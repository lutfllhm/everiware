<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>Everiware</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>iware_absenku</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>MinimumOSVersion</key>
	<string>13.0</string>

	<!-- ===================== PERMISSIONS ===================== -->

	<!-- Kamera — untuk absensi selfie & face detection -->
	<key>NSCameraUsageDescription</key>
	<string>Aplikasi membutuhkan akses kamera untuk absensi dengan selfie dan deteksi wajah.</string>

	<!-- Galeri foto — untuk upload foto profil -->
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Aplikasi membutuhkan akses galeri untuk memilih foto profil.</string>
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>Aplikasi membutuhkan izin untuk menyimpan foto ke galeri.</string>

	<!-- Lokasi — untuk verifikasi lokasi absensi -->
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Aplikasi membutuhkan akses lokasi untuk memverifikasi lokasi saat absensi.</string>
	<key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
	<string>Aplikasi membutuhkan akses lokasi untuk memverifikasi lokasi absensi.</string>
	<key>NSLocationAlwaysUsageDescription</key>
	<string>Aplikasi membutuhkan akses lokasi untuk memverifikasi lokasi absensi.</string>

	<!-- Biometrik — untuk Face ID / Touch ID login -->
	<key>NSFaceIDUsageDescription</key>
	<string>Aplikasi menggunakan Face ID untuk autentikasi yang lebih cepat dan aman.</string>

	<!-- Mikrofon — dibutuhkan oleh camera plugin -->
	<key>NSMicrophoneUsageDescription</key>
	<string>Aplikasi membutuhkan akses mikrofon yang diperlukan oleh kamera.</string>

	<!-- ===================== URL SCHEMES ===================== -->
	<key>CFBundleURLTypes</key>
	<array>
		<!-- Deep link scheme: everiware:// -->
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLName</key>
			<string>com.everiware.app</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>everiware</string>
			</array>
		</dict>
		<!-- Google Sign-In (ganti REVERSED_CLIENT_ID dengan nilai dari GoogleService-Info.plist) -->
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>$(REVERSED_CLIENT_ID)</string>
			</array>
		</dict>
	</array>

	<!-- ===================== UI CONFIG ===================== -->
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string></string>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UIViewControllerBasedStatusBarAppearance</key>
	<false/>
	<key>UIStatusBarStyle</key>
	<string>UIStatusBarStyleLightContent</string>

	<!-- ===================== NETWORK ===================== -->
	<!-- Allow HTTP untuk development (hapus di production) -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoads</key>
		<true/>
		<key>NSAllowsArbitraryLoadsInWebContent</key>
		<true/>
	</dict>

	<!-- ===================== FLUTTER ===================== -->
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
</dict>
</plist>
